// Staging.xcconfig
// QA·내부 배포용 설정. Release 와 같은 최적화로 빌드하고 스테이징 서버를 본다.
//
// 여기에는 "환경마다 값이 갈리는 것"만 둔다.
// 공통 값은 Tuist/ProjectDescriptionHelpers 쪽 Swift 코드에 있다.
//
// 컴파일 조건(SWIFT_ACTIVE_COMPILATION_CONDITIONS)은 Release 와 같게 둔다. `#if STAGING` 같은 분기를 만들지 않고,
// 환경 차이는 아래 값(Info.plist 경유)으로만 낸다. 그래야 QA 가 본 바이너리와 배포 바이너리의 코드 경로가 같다.

// MARK: - App identity
// BUNDLE_ID_SUFFIX 덕분에 정식 앱·개발 빌드와 나란히 설치된다.
// APP_NAME 은 Tuist 설정(AppConstants.appName)에서 온다.

APP_DISPLAY_NAME = $(APP_NAME) Stg
BUNDLE_ID_SUFFIX = .stg

// MARK: - Versioning

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Compiler

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s

// MARK: - Build behavior
// QA 빌드의 크래시도 심볼을 복원할 수 있도록 dSYM 을 만든다.

ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
VALIDATE_PRODUCT = YES

// MARK: - Runtime configuration

API_BASE_URL = https:/$()/staging-api.example.com
LOG_LEVEL = info

// MARK: - Push
// TestFlight·Ad Hoc 으로 배포한 빌드는 APNs 운영 서버로 토큰을 받는다.

APS_ENVIRONMENT = production

// MARK: - Signing

#include "Signing.xcconfig"

// MARK: - Client keys

#include? "ClientKeys.xcconfig"
