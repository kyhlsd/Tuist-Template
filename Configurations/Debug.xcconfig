// Debug.xcconfig
// 로컬 개발용 설정.
//
// 여기에는 "환경마다 값이 갈리는 것"만 둔다.
// 모든 환경이 공유하는 값(SWIFT_VERSION, 배포 타겟, 번들 ID 접두사 등)은
// Tuist/ProjectDescriptionHelpers 쪽 Swift 코드에 있다.
// 같은 키를 양쪽에 중복 정의하면 Swift 쪽이 이겨서 여기 값이 무시된다.

// MARK: - App identity
// BUNDLE_ID_SUFFIX 덕분에 개발 빌드가 정식 앱과 나란히 설치된다.
// APP_NAME 은 Tuist 설정(AppConstants.appName)에서 온다.

APP_DISPLAY_NAME = $(APP_NAME) Dev
BUNDLE_ID_SUFFIX = .dev

// MARK: - Versioning

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Compiler
// 빠른 반복을 위해 최적화를 끄고 증분 컴파일을 쓴다.

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = incremental
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1

// MARK: - Build behavior
// ENABLE_TESTABILITY 가 켜져 있어야 @testable import 가 동작한다.

ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
VALIDATE_PRODUCT = NO

// MARK: - Runtime configuration
// URL 의 // 는 주석으로 해석되므로 슬래시 사이에 $() 를 끼워 넣는다.

API_BASE_URL = https:/$()/dev-api.example.com
LOG_LEVEL = debug

// MARK: - Client keys
// 앱 번들에 실리는 공개 키. 서버 시크릿은 여기 오지 않는다.
// 마지막에 include 해야 위 값들을 덮어쓸 수 있고,
// #include? 는 파일이 없어도 빌드가 깨지지 않는 형태다.

#include? "ClientKeys.xcconfig"
