import DesignSystem
import {{ name }}
import {{ name }}Interface
import Navigation
import SwiftUI

@main
struct {{ name }}DemoApp: App {
    @State private var router = Router()

    var body: some Scene {
        WindowGroup {
            NavigationStack(path: $router.path) {
                {{ name }}View()
                    .navigationDestination(for: {{ name }}Route.self) { route in
                        switch route {
                        case .main:
                            {{ name }}View()
                        }
                    }
            }
            .theme(.standard)
        }
    }
}
