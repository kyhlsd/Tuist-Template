{
  "permissions": {
    "allow": [
      "Bash(./.claude/scripts/review-snapshot.sh)",
      "Bash(.claude/scripts/review-snapshot.sh)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-tools.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh",
            "timeout": 10,
            "statusMessage": "브랜치 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/swift-quality.sh",
            "timeout": 60,
            "statusMessage": "Swift 검사 중"
          }
        ]
      }
    ]
  }
}
